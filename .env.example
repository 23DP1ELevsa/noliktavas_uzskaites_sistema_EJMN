SECRET_KEY=replace-with-a-local-secret
DATABASE_URL=mysql+pymysql://stockflow:stockflow@localhost:3306/stockflow?charset=utf8mb4
# Railway: set DATABASE_URL to a reference to the MySQL service's MYSQL_URL.
# For a local app connecting to Railway, use MYSQL_PUBLIC_URL instead.
# Optional separate demo API; otherwise StockFlow calls its own /api/test/offers.
# TEST_API_URL=http://127.0.0.1:5001/api/test/offers
